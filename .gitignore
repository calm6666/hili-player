# ============================================
dist/

# ============================================
# 操作系统
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# 环境变量 / 密钥
# ============================================
.env
.env.local
.env.*.local

# ============================================
# 工具临时产物
# ============================================
# pnpm 内容寻址存储 / 依赖缓存：不入库
.pnpm-store/
# Vite 配置时间戳临时文件
*.timestamp-*.mjs
# 无头浏览器临时用户目录
.chrome-tmp/
# mock-server 运行时拉取的媒体缓存（测试视频/雪碧图二进制）：不入库
mock-server/.cache/
# IDE 工具会话目录
.trae/
# 早期独立播放器演示页（已废弃，主 demo 在 demo/ 根）
demo/player-demo/

# ============================================
# 日志
# ============================================
*.log
npm-debug.log*
pnpm-debug.log*

