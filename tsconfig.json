{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/player/src/*"],
      "@/types": ["types/index.ts"],
      "@/types/*": ["types/*"],
      "@/core": ["core/index.ts"],
      "@/core/*": ["core/*"],
      "@/utils": ["utils/index.ts"],
      "@/utils/*": ["utils/*"],
      "@/directives": ["directives/index.ts"],
      "@/directives/*": ["directives/*"],
      "@/events": ["events/index.ts"],
      "@/events/*": ["events/*"],
      "@/error": ["error/index.ts"],
      "@/error/*": ["error/*"],
      "@/nova/*": ["packages/player/src/*"],
      "@/lumina/plugins/*": ["packages/plugins/src/*"],
      "@lumina/nova": ["packages/player/src/index.ts"],
      "hls.js": ["hls-fork/dist/hls"]
    }
  },
  "include": [
    "vite-env.d.ts",
    "core/**/*",
    "types/**/*",
    "utils/**/*",
    "directives/**/*",
    "events/**/*",
    "error/**/*",
    "plugins/**/*",
    "packages/player/src/**/*",
    "packages/plugins/src/**/*",
    "hls-fork/dist/hls.d.ts",
    "demo/**/*",
    "demo-prod/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
