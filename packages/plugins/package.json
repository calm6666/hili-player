{
  "name": "@hili-player/plugins",
  "version": "1.0.0",
  "description": "hili-player 官方插件集合",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./danmaku": {
      "import": "./dist/danmaku.js",
      "types": "./dist/danmaku.d.ts"
    },
    "./subtitle": {
      "import": "./dist/subtitle.js",
      "types": "./dist/subtitle.d.ts"
    },
    "./dash": {
      "import": "./dist/dash.js",
      "types": "./dist/dash.d.ts"
    },
    "./hls": {
      "import": "./dist/hls.js",
      "types": "./dist/hls.d.ts"
    },
    "./flv": {
      "import": "./dist/flv.js",
      "types": "./dist/flv.d.ts"
    },
    "./interaction": {
      "import": "./dist/interaction/index.js",
      "types": "./dist/interaction/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video-player",
    "plugins",
    "danmaku",
    "subtitle",
    "interaction",
    "dash",
    "hls",
    "flv"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hili-player/player": "workspace:*"
  },
  "dependencies": {
    "dashjs": "^5.1.1",
    "flv.js": "^1.6.2"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  }
}
